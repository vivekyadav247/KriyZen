# KriyZen environment template (P02.1)
# Copy to .env.local and replace the password with a generated local secret.
# Docker Compose must be given this file explicitly with --env-file .env.local.

POSTGRES_DB=kriyzen
POSTGRES_USER=kriyzen
POSTGRES_PASSWORD=replace-with-a-generated-local-password
POSTGRES_HOST_PORT=5433

# Local-only connection string for the future Drizzle application setup.
# Keep the username/password/host port in sync with the POSTGRES_* values above.
DATABASE_URL=postgresql://kriyzen:replace-with-a-generated-local-password@localhost:5433/kriyzen
